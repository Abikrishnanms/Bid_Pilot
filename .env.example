POSTGRES_USER=bidpilot_user
POSTGRES_PASSWORD=bidpilot_pass
POSTGRES_DB=bidpilot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bidpilot_user:bidpilot_pass@postgres:5432/bidpilot_db

# LLM & Embedding provider configuration
# LLM_PROVIDER can be 'anthropic', 'gemini', or 'mock' (for offline testing)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding provider: 'sentence-transformers', 'gemini', 'openai', or 'mock'
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
